# ── Obrigatório ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Modelo (opcional). Padrão: claude-sonnet-4-6.
# Use claude-opus-5 se quiser raciocínio mais forte nas perguntas de gestão.
NEXUS_MODEL=

# ── Memória do próprio NEXUS (histórico, rotinas, memórias) ────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Financeiro do Grupo MH (grupo-mh-financeiro) ───────────────
# Leitura e lançamento acontecem por RPC, isoladas por p_email.
FINANCEIRO_SUPABASE_URL=https://SEU-PROJETO.supabase.co
FINANCEIRO_SUPABASE_KEY=
FINANCEIRO_USER_EMAIL=voce@exemplo.com

# ── Opera / mh-gestao (processos, agenda, WhatsApp, comercial) ─
# ATENÇÃO: base multi-tenant. OPERA_USER_ID fixa de quem o NEXUS lê.
# Ele NUNCA vem do request — se viesse, uma resposta mal formada
# leria a conta de outro perito.
OPERA_SUPABASE_URL=https://SEU-PROJETO.supabase.co
OPERA_SUPABASE_KEY=
OPERA_USER_ID=

# ── Plataforma Nexus / Peritos Academy (assinaturas) ───────────
PERITOS_SUPABASE_URL=https://SEU-PROJETO.supabase.co
PERITOS_SUPABASE_KEY=

# ── Outros produtos do ecossistema (leitura agregada) ─────────
# Só contagens e panoramas — o Marlos aqui é dono, não usuário.
ACADEMY_SUPABASE_URL=https://SEU-PROJETO.supabase.co
ACADEMY_SUPABASE_KEY=
PONTO_SUPABASE_URL=https://SEU-PROJETO.supabase.co
PONTO_SUPABASE_KEY=
GALACTICOS_SUPABASE_URL=https://SEU-PROJETO.supabase.co
GALACTICOS_SUPABASE_KEY=
ACHEUMPERITO_SUPABASE_URL=https://SEU-PROJETO.supabase.co
ACHEUMPERITO_SUPABASE_KEY=

# Produtos que voce NAO quer acompanhar (some do panorama, sem virar lacuna)
PRODUTOS_IGNORADOS=

# ── Rotina proativa (cron do vigia) ───────────────────────────
# Sem CRON_SECRET o endpoint /api/rotina fica DESLIGADO (503) —
# ele mora numa URL pública e dispara e-mail.
CRON_SECRET=
# Entrega dos alertas. Sem estes dois, a rotina roda e só devolve JSON.
RESEND_API_KEY=
ALERTA_EMAIL_PARA=
ALERTA_EMAIL_DE=NEXUS <onboarding@resend.dev>
# Horas de silêncio entre avisos idênticos (padrão 10).
ALERTA_JANELA_HORAS=
# Ponha 0 para o NEXUS não checar pendências ao abrir a conversa.
NEXUS_VIGIA_NA_ABERTURA=

# ── WhatsApp (Evolution API) ──────────────────────────────────
# SAÍDA funciona com qualquer instância conectada — enviar não mexe
# em webhook nenhum. ENTRADA (conversar com o NEXUS) exige uma
# instância DEDICADA: cada instância tem uma só URL de webhook, e
# repontar uma de atendimento faz o cliente ficar sem resposta.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
WHATSAPP_INSTANCIA=
# Só este número conversa com o NEXUS. Ele lê o financeiro inteiro
# e escreve na agenda — número desconhecido aqui é vazamento.
WHATSAPP_DONO=
# Vai na query da URL do webhook (a Evolution não manda cabeçalho
# de auth). Sem ele, a entrada fica desligada.
WHATSAPP_WEBHOOK_SECRET=

# ── Integrações opcionais ─────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
MAKE_WEBHOOKS=

# ── Fontes MCP (opcionais; sem token a fonte é ignorada) ───────
WINDSOR_MCP_TOKEN=
GDRIVE_MCP_TOKEN=
MAKE_MCP_TOKEN=
FACEBOOK_MCP_TOKEN=
CANVA_MCP_TOKEN=
