{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "memorias.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "icons/**",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.ico",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/spotify/(.*)",
      "dest": "/api/spotify.js"
    },
    {
      "src": "/api/([^/.]+)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/bom-dia",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/rotina",
      "schedule": "0 19 * * 1-5"
    },
    {
      "path": "/api/fim-do-dia",
      "schedule": "30 21 * * 1-5"
    }
  ]
}
